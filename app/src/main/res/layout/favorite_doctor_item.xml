<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="10dp"

    >

    <ImageView
        android:id="@+id/favorites_doctor_item_image"
        android:layout_width="115dp"
        android:layout_height="115dp"

        android:background="@drawable/eight_dp_radius_background"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        />

    <Space
        android:layout_width="18dp"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:lineHeight="18sp"
            android:ellipsize="end"
            android:maxLines="2"
            android:id="@+id/favorites_doctor_item_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dr Doctor"
            android:fontFamily="@font/inter_semibald"
            android:textSize="18sp"
            android:textColor="@color/black"
            />


        <TextView
            android:id="@+id/favorites_doctor_item_speciality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="speciality"
            android:fontFamily="@font/inter_semibald"
            android:textSize="12sp"
            android:textColor="@color/text_gray"
            />
        <Space
            android:layout_width="wrap_content"
            android:layout_height="2dp" />


        <LinearLayout
            android:backgroundTint="@color/strange_color"
            android:background ="@drawable/home_doctors_item_rating_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="1dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/star"
                android:padding="3dp"
                />
            <TextView
                android:layout_marginTop="2dp"
                android:layout_marginBottom= "2dp"
                android:layout_marginEnd="3dp"
                android:fontFamily="@font/inter_medium"

                android:id="@+id/favorites_doctor_item_rating"
                android:paddingEnd="2dp"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4,7"
                android:textSize="12sp"
                android:lineHeight="10sp"
                android:textColor="@color/blue"

                />
        </LinearLayout>

        <Space
            android:layout_width="wrap_content"
            android:layout_height="4dp"/>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/location"/>
            <Space
                android:layout_width="4dp"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/favorites_doctor_item_distance"
                android:textSize="12sp"
                android:fontFamily="@font/inter_medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15 km"
                />
        </LinearLayout>




    </LinearLayout>



</LinearLayout>